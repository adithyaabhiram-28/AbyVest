# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=generate_a_long_random_string
FLASK_ENV=production
FLASK_DEBUG=0

POSTGRES_USER=postgres
POSTGRES_PASSWORD=choose_a_strong_password
POSTGRES_DB=smartstocktracker

# Inside Docker Compose, use service hostnames (postgres / redis), not localhost.
# URL-encode special characters in the password (e.g. # -> %23).
DATABASE_URL=postgresql://postgres:choose_a_strong_password@postgres:5432/smartstocktracker
REDIS_URL=redis://redis:6379

FINNHUB_API_KEY=your_finnhub_api_key
GENAI_API_KEY=your_gemini_api_key

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
